---
import PortfolioLayout from "./PortfolioLayout.astro";
import { Image } from "astro:assets";
import SkillBadge from "../components/SkillBadge.astro";
import { ExternalLink } from "@lucide/astro";
import ContentSidebar from "../components/ContentSidebar.astro";
import type { ImageMetadata, MarkdownHeading } from "astro";
import type { ResolvedContentSidebar } from "../utils/contentSidebar";
import { messages, type Locale } from "../data/i18n";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  contentLanguage: Locale;
  alternateLocales: Locale[];
  startDate?: Date;
  endDate?: Date;
  period?: string;
  image?: ImageMetadata | string;
  skills?: string[];
  demoLink?: string;
  sourceLink?: string;
  headings: MarkdownHeading[];
  contentSidebar: ResolvedContentSidebar;
  projectType?: string;
  adviser?: string;
  organization?: string;
}

const {
  locale,
  title,
  description,
  contentLanguage,
  alternateLocales,
  startDate,
  endDate,
  period,
  image,
  skills,
  demoLink,
  sourceLink,
  headings,
  contentSidebar,
  projectType,
  adviser,
  organization,
} = Astro.props;
const t = messages[locale];
const outlineHeadings = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3
);
const hasContentSidebar = contentSidebar.show && outlineHeadings.length > 0;

function formatPeriod(startDate: Date, endDate?: Date) {
  const options: Intl.DateTimeFormatOptions = {
    month: "short",
    year: "numeric",
  };
  const start = startDate.toLocaleDateString(locale, options);
  const end = endDate
    ? endDate.toLocaleDateString(locale, options)
    : t.present;
  return `${start} - ${end}`;
}

// Calculate project duration
function calculateDuration(startDate: Date, endDate?: Date) {
  const end = endDate || new Date();
  const months =
    (end.getFullYear() - startDate.getFullYear()) * 12 +
    (end.getMonth() - startDate.getMonth());

  if (months < 1) return locale === "th" ? "น้อยกว่า 1 เดือน" : "Less than a month";

  const formatUnit = (value: number, unit: "month" | "year") =>
    new Intl.NumberFormat(locale, { style: "unit", unit, unitDisplay: "long" }).format(value);
  if (months < 12) return formatUnit(months, "month");

  const years = Math.floor(months / 12);
  const remainingMonths = months % 12;

  if (remainingMonths === 0) return formatUnit(years, "year");
  return `${formatUnit(years, "year")}, ${formatUnit(remainingMonths, "month")}`;
}
---

<PortfolioLayout locale={locale} title={title} description={description} alternateLocales={alternateLocales}>
  <article class="mx-auto max-w-7xl px-4 py-20">
    <div class="mx-auto max-w-4xl">
      <!-- Back button -->
      <div class="mb-8">
        <a href={`/${locale}/project`} class="btn btn-ghost btn-sm">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
          {t.backToProjects}
        </a>
      </div>

      <!-- Featured Image -->
      <!-- TODO: Future Enhancement - Support multiple images/project gallery -->
      {
        image && (
          <figure class="mb-8 overflow-hidden rounded-2xl">
            {typeof image === "string" ? (
              <img src={image} alt={title} class="w-full aspect-video object-cover" width="1200" height="630" />
            ) : (
              <Image src={image} alt={title} class="w-full aspect-video object-cover" width={1200} height={630} />
            )}
          </figure>
        )
      }

      <!-- Project Header -->
      <header class="mb-8">
        <h1 class="mb-4 text-4xl font-bold sm:text-5xl">{title}</h1>
        {description && <p class="mb-6 text-lg text-base-content/70 sm:text-xl" lang={contentLanguage}>{description}</p>}
        {adviser && <p class="mb-2 text-base-content/70 " lang={contentLanguage}> 
        <span class="font-semibold">{t.advisor}</span>: {adviser}</p>}
        {organization && <p class="mb-2 text-base-content/70 " lang={contentLanguage}>
        <span class="font-semibold">{t.organization}</span>: {organization}</p>}

        {(startDate || period) && (
        <div
          class="mb-6 mt-4 flex flex-wrap items-center gap-4 text-sm text-base-content/60"
        >
        <span class="font-semibold">{startDate ? formatPeriod(startDate, endDate) : period?.replace("Present", t.present)}</span>
        {startDate && <><span>•</span><span>{calculateDuration(startDate, endDate)}</span></>}
        {
          startDate && !endDate && (
            <>
              <span>•</span>
              <span class="badge badge-success badge-sm">{t.ongoing}</span>
            </>
          )
        }
        </div>
        )}

        <!-- Prominent Action Buttons -->
        {
          (demoLink || sourceLink) && (
            <div class="mb-6 flex flex-wrap gap-3">
            {demoLink && (
              <a
                href={demoLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary gap-2"
              >
                <ExternalLink class="size-5" />
                {t.liveDemo}
              </a>
            )}
            {sourceLink && (
              <a
                href={sourceLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-soft gap-2"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 32 32"
                  fill="currentColor"
                >
                  <path d="M16,2.345c7.735,0,14,6.265,14,14-.002,6.015-3.839,11.359-9.537,13.282-.7,.14-.963-.298-.963-.665,0-.473,.018-1.978,.018-3.85,0-1.312-.437-2.152-.945-2.59,3.115-.35,6.388-1.54,6.388-6.912,0-1.54-.543-2.783-1.435-3.762,.14-.35,.63-1.785-.14-3.71,0,0-1.173-.385-3.85,1.435-1.12-.315-2.31-.472-3.5-.472s-2.38,.157-3.5,.472c-2.677-1.802-3.85-1.435-3.85-1.435-.77,1.925-.28,3.36-.14,3.71-.892,.98-1.435,2.24-1.435,3.762,0,5.355,3.255,6.563,6.37,6.913-.403,.35-.77,.963-.893,1.872-.805,.368-2.818,.963-4.077-1.155-.263-.42-1.05-1.452-2.152-1.435-1.173,.018-.472,.665,.017,.927,.595,.332,1.277,1.575,1.435,1.978,.28,.787,1.19,2.293,4.707,1.645,0,1.173,.018,2.275,.018,2.607,0,.368-.263,.787-.963,.665-5.719-1.904-9.576-7.255-9.573-13.283,0-7.735,6.265-14,14-14Z" />
                </svg>
                {t.viewSource}
              </a>
            )}
            </div>
          )
        }
      </header>

      <!-- Tech Stack Showcase -->
      {
        skills && skills.length > 0 && (
          <div class="card mb-8 bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-lg mb-3">{t.techStack}</h2>
            <div class="flex flex-wrap gap-2">
              {skills.map((skill) => (
                <SkillBadge skill={skill} />
              ))}
            </div>
          </div>
          </div>
        )
      }

      <div class="divider"></div>
    </div>

    <div
      class:list={[
        "article-body-shell",
        {
          "article-body-shell--with-sidebar": hasContentSidebar,
          "article-body-shell--left": hasContentSidebar && contentSidebar.position === "left",
          "article-body-shell--right": hasContentSidebar && contentSidebar.position === "right",
        },
      ]}
    >
      {hasContentSidebar && (
        <div class="article-outline-column">
          <ContentSidebar
            headings={outlineHeadings}
            position={contentSidebar.position}
            locale={locale}
          />
        </div>
      )}

      <div class="article-main min-w-0">
        {contentLanguage !== locale && (
          <p role="status" class="alert alert-info mb-6">{t.original}</p>
        )}
        <div class="article-prose prose  max-w-none" lang={contentLanguage}>
          <slot />
        </div>

        <div class="divider mt-12"></div>

        <div class="mt-8 text-center">
          <a href={`/${locale}/project`} class="btn btn-primary">{t.allProjects}</a>
        </div>
      </div>
    </div>
  </article>
</PortfolioLayout>

<style>
  .article-body-shell {
    margin-inline: auto;
    max-width: 56rem;
  }

  .article-body-shell--with-sidebar {
    display: grid;
    grid-template-areas: "outline" "content";
    gap: 2rem;
  }

  .article-outline-column {
    grid-area: outline;
    min-width: 0;
  }

  .article-main {
    grid-area: content;
  }

  :global(.article-prose :where(h1, h2)) {
    scroll-margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .article-body-shell--with-sidebar {
      gap: 3rem;
    }

    .article-body-shell--right {
      grid-template-areas: "content outline";
      grid-template-columns: minmax(0, 1fr) 16rem;
    }

    .article-body-shell--left {
      grid-template-areas: "outline content";
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }
</style>
